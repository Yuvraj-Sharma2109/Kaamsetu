# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Firebase Web app config (public client config; restrict its API key to your domains).
# Create these values in Firebase Console → Project settings → Your apps.
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_WEB_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="YOUR_PROJECT_ID.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="YOUR_PROJECT_ID"
VITE_FIREBASE_APP_ID="YOUR_FIREBASE_WEB_APP_ID"
VITE_FIREBASE_MESSAGING_SENDER_ID="YOUR_FIREBASE_SENDER_ID"
VITE_FIREBASE_STORAGE_BUCKET="YOUR_PROJECT_ID.firebasestorage.app"

# Optional: set this to an OSRM-compatible routing server you operate for production.
# The built-in public OSRM demo endpoint is best-effort and intended for limited non-commercial use.
VITE_OSRM_ROUTER_URL="https://router.project-osrm.org"

# Optional: self-host Photon or use a provider for higher-volume place search/geocoding.
VITE_PHOTON_API_URL="https://photon.komoot.io/api"

# Optional: choose an OSM-compatible tile provider. Do not use tile scraping or prefetching.
VITE_OSM_TILE_URL="https://tile.openstreetmap.org/{z}/{x}/{y}.png"
